/**app.wxss 全局视觉基座：色板/间距/通用类（Skyline 下不用 CSS 变量，统一用类）**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
  color: #222;
  font-size: 28rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
}

/* 价格 */
.price {
  color: #ff5000;
  font-weight: 600;
}

.price-unit {
  font-size: 22rpx;
  margin-right: 2rpx;
}

/* 主按钮 / 次按钮 */
.btn-accent {
  background: #ff6b35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-ghost {
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.dim {
  opacity: 0.6;
}

/* 状态标签 */
.tag {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #fff2ec;
  color: #ff6b35;
}

.tag-grey {
  background: #f2f2f2;
  color: #999;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 160rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 分割 */
.divider {
  height: 1rpx;
  background: #f2f2f2;
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}