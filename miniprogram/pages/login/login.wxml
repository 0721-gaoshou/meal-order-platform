<!--login.wxml-->
<navigation-bar title="登录" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="body">
  <view class="brand">
    <view class="brand-logo">点</view>
    <view class="brand-name">点餐平台</view>
    <view class="brand-sub">登录后加购、下单、查看订单与优惠券</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="field-label">账号</text>
      <input class="field-input" value="{{username}}" placeholder="请输入账号" bindinput="onInputUsername" />
    </view>
    <view class="divider"></view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="field-input" value="{{password}}" password placeholder="请输入密码" bindinput="onInputPassword" />
    </view>
  </view>

  <view class="btn-accent login-btn" hover-class="dim" bindtap="onTapLogin">
    {{submitting ? '登录中…' : '登录'}}
  </view>

  <view class="dev-note">开发占位：微信一键登录将在后续版本接入</view>
</view>