/**goods-detail.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.hero {
  width: 100%;
  height: 460rpx;
}

.hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efefef;
  color: #bbb;
  font-size: 30rpx;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 28rpx 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

.tags {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.price-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
}

.price-big {
  font-size: 44rpx;
}

.stock {
  font-size: 22rpx;
  color: #999;
}

.stock-out {
  color: #e5533d;
}

.desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.spec-row {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.spec-label {
  font-size: 28rpx;
  color: #222;
}

.spec-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #999;
}

.arrow {
  font-size: 30rpx;
  color: #ccc;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.cart-entry {
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.footer-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.sheet-price {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
}

.sheet-stock {
  font-size: 22rpx;
  color: #999;
}

.sheet-close {
  font-size: 44rpx;
  color: #999;
  padding: 0 8rpx;
}

.sheet-label {
  font-size: 26rpx;
  color: #666;
}

.sku-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 32rpx;
  border-radius: 14rpx;
  background: #f6f6f6;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #333;
}

.sku-on {
  background: #fff2ec;
  border-color: #ff6b35;
  color: #ff6b35;
}

.sku-off {
  color: #ccc;
}

.sku-off .sku-price {
  color: #ccc;
}

.sku-price {
  font-size: 22rpx;
  color: #999;
}

.qty-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.step {
  width: 56rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
}

.step-hover {
  background: #f2f2f2;
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.sheet-total {
  font-size: 26rpx;
  color: #666;
  text-align: right;
}

.sheet-total .price {
  font-size: 36rpx;
}

.confirm {
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.confirm-disabled {
  opacity: 0.6;
}