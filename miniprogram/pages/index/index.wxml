<!--index.wxml 首页：搜索 + 分类 + 商品流-->
<navigation-bar title="点餐" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<view class="login-strip" wx:if="{{!token}}">
  <text>登录后可加购下单</text>
  <view class="strip-btn" hover-class="dim" bindtap="onTapLogin">{{loggingIn ? '登录中…' : '登录'}}</view>
</view>

<view class="search-wrap">
  <input
    class="search"
    placeholder="搜索商品"
    placeholder-class="search-ph"
    value="{{keyword}}"
    confirm-type="search"
    bindinput="onSearchInput"
    bindconfirm="onSearchConfirm"
  />
</view>

<scroll-view class="cats" scroll-x>
  <view class="cats-inner">
    <view
      class="cat {{!activeCategoryId ? 'cat-on' : ''}}"
      data-id=""
      bindtap="onTapCategory"
    >全部</view>
    <view
      class="cat {{activeCategoryId === item.id ? 'cat-on' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapCategory"
    >{{item.name}}</view>
  </view>
</scroll-view>

<scroll-view class="scrollarea" scroll-y type="list" bindscrolltolower="onReachBottom">
  <view class="list">
    <view class="goods-card" wx:for="{{list}}" wx:key="spuId" hover-class="dim" data-id="{{item.spuId}}" bindtap="onTapGoods">
      <image wx:if="{{item.image}}" class="goods-thumb" src="{{item.image}}" mode="aspectFill"></image>
      <view wx:else class="goods-thumb goods-thumb-empty">图</view>
      <view class="goods-main">
        <view class="goods-name ellipsis">{{item.name}}</view>
        <view class="goods-tags" wx:if="{{item.tagList.length}}">
          <text class="tag" wx:for="{{item.tagList}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="goods-desc ellipsis">{{item.description}}</view>
        <view class="goods-bottom">
          <view class="goods-price-wrap">
            <text class="price"><text class="price-unit">¥</text>{{item.priceText}}</text>
            <text class="goods-spec" wx:if="{{item.specCount > 1}}">{{item.specCount}} 种规格</text>
          </view>
          <view
            class="add-btn"
            hover-class="dim"
            data-skuid="{{item.skuId}}"
            data-stock="{{item.stock}}"
            catchtap="onTapAdd"
          >+</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!list.length && !loading}}" class="empty">没有找到商品</view>
    <view wx:if="{{loading}}" class="list-tip">加载中…</view>
    <view wx:if="{{!hasMore && list.length}}" class="list-tip">— 到底了 —</view>
  </view>
</scroll-view>

<view class="cart-float" hover-class="dim" bindtap="onTapCart">
  <text>购物车</text>
  <view class="cart-badge" wx:if="{{cartCount}}">{{cartCount}}</view>
</view>