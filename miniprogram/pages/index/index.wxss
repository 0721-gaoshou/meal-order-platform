/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding-top: 120rpx;
}

.health-result {
  font-size: 26rpx;
  color: #666;
  padding: 0 40rpx;
  text-align: center;
  word-break: break-all;
}

