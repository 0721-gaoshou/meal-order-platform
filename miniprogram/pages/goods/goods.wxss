/**goods.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 24rpx 160rpx;
}

.goods-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.goods-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  color: #bbb;
  font-size: 26rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-name {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #ff5000;
  font-weight: 600;
}

/* 加购弹性：类切换触发 overshoot 过渡，成功才弹 */
.add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ff6b35;
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.add-pop {
  transform: scale(1.32);
}

.add-hover {
  opacity: 0.75;
}

.empty,
.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.cart-float {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  padding: 20rpx 32rpx;
  background: #fff;
  color: #ff6b35;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}
