/**cart.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
}

.head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
}

.head-count {
  font-size: 26rpx;
  color: #666;
}

.head-clear {
  font-size: 26rpx;
  color: #999;
}

.dim {
  opacity: 0.6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.rows {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0 200rpx;
}

.slot {
  position: relative;
  margin: 0 24rpx 20rpx;
}

.trash {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffe3dd;
  color: #e5533d;
  font-size: 28rpx;
  border-radius: 20rpx;
}

.card {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 松手吸附才开过渡；跟手时关掉 */
.snap {
  transition: transform 240ms cubic-bezier(0.3, 1.3, 0.5, 1);
}

.card-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  transform: translate(0, 0) scale(1);
  opacity: 1;
}

/* 两阶段曲线飞出：先上扬缩小，再向右下旋转淡出 */
.fly-a {
  transform: translate(120rpx, -30rpx) scale(0.82);
  opacity: 0.9;
  transition: transform 180ms ease-in, opacity 180ms ease-in;
}

.fly-b {
  transform: translate(420rpx, 300rpx) rotate(14deg) scale(0.12);
  opacity: 0;
  transition: transform 240ms ease-in, opacity 240ms ease-in;
}

/* 勾选：状态即时，视觉靠 vChecked 错峰驱动；overshoot 缓动给出弹性过冲 */
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #fff;
}

.check .tick {
  color: #fff;
  font-size: 28rpx;
  transform: scale(0);
  transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.check.checked {
  background: #ff6b35;
  border-color: #ff6b35;
}

.check.checked .tick {
  transform: scale(1);
}

.check.disabled {
  border-color: #eee;
  background: #f5f5f5;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  color: #bbb;
  font-size: 24rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.name {
  font-size: 28rpx;
  color: #222;
}

.spec {
  font-size: 24rpx;
  color: #999;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.invalid-tag {
  font-size: 20rpx;
  color: #e5533d;
  border: 1rpx solid #e5533d;
  border-radius: 6rpx;
  padding: 0 8rpx;
}

.row-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}

.price {
  font-size: 30rpx;
  color: #ff5000;
  font-weight: 600;
}

.stock-hint {
  font-size: 22rpx;
  color: #e5533d;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.step {
  width: 56rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
}

.step-hover {
  background: #f2f2f2;
}

.qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #222;
  transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.qty-pop {
  transform: scale(1.22);
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 160rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.all {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.all-box.checked {
  background: #ff6b35;
  border-color: #ff6b35;
}

.total {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #666;
}

.total-num {
  font-size: 34rpx;
  color: #ff5000;
  font-weight: 600;
}

.go {
  padding: 18rpx 36rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.go-disabled {
  background: #ddd;
  color: #fff;
}

.go-hover {
  opacity: 0.85;
}
