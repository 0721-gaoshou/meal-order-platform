<!--checkout.wxml-->
<navigation-bar title="结算" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="body" wx:if="{{ready}}">
    <view class="card">
      <view class="item" wx:for="{{items}}" wx:key="skuId">
        <view class="item-info">
          <view class="item-name">{{item.spuName}}</view>
          <view class="item-spec">{{item.skuSpec}} · ¥{{item.priceText}} × {{item.quantity}}</view>
        </view>
        <view class="item-right">
          <view class="item-sub">¥{{item.subtotalText}}</view>
          <view class="item-share" wx:if="{{item.shareText}}">{{item.shareText}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="coupon-row" hover-class="dim" bindtap="openSheet">
        <text class="label">优惠券</text>
        <view class="coupon-value">
          <text wx:if="{{couponName}}" class="coupon-name">{{couponName}} -¥{{discountText}}</text>
          <text wx:else class="coupon-none">{{usableCount ? usableCount + ' 张可用' : '暂无可用'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="label-row">
        <text class="label">备注</text>
        <text class="count">{{remark.length}}/255</text>
      </view>
      <textarea
        class="remark"
        value="{{remark}}"
        maxlength="255"
        placeholder="口味、取餐偏好等（可不填）"
        bindinput="onInputRemark"
      ></textarea>
    </view>

    <view class="hint">数量与价格以服务端购物车实时值为准；库存不足或券被抢用会在提交时整体回滚</view>
  </view>

  <view wx:else class="offline">
    <view>结算信息不可用（商品可能已下架或条目已变动）</view>
    <view class="retry" hover-class="dim" bindtap="onTapRefresh">重新试算</view>
  </view>
</scroll-view>

<view class="footer" wx:if="{{ready}}">
  <view class="totals">
    <view class="total-line">合计 ¥{{totalText}}<text wx:if="{{discountText !== '0.00'}}" class="total-line-off">优惠 -¥{{discountText}}</text></view>
    <view class="total">实付 <text class="total-num">¥{{payText}}</text></view>
  </view>
  <button
    class="submit"
    hover-class="submit-hover"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onTapSubmit"
  >
    提交订单
  </button>
</view>

<view class="mask" wx:if="{{sheet}}" bindtap="closeSheet"></view>
<view class="sheet" wx:if="{{sheet}}">
  <view class="sheet-title">选择优惠券</view>
  <view class="sheet-list">
    <view
      class="sheet-item {{!item.usable ? 'sheet-item-off' : ''}}"
      wx:for="{{usable}}"
      wx:key="userCouponId"
      data-id="{{item.userCouponId}}"
      data-usable="{{item.usable}}"
      bindtap="onPickCoupon"
    >
      <view class="sheet-item-main">
        <view class="sheet-item-name">{{item.name}}</view>
        <view class="sheet-item-desc">{{item.typeText}}<text wx:if="{{!item.usable}}"> · {{item.reason}}</text></view>
      </view>
      <view class="sheet-item-value">
        <text wx:if="{{item.usable}}" class="sheet-item-off-amount">-¥{{item.estimatedText}}</text>
        <text wx:if="{{userCouponId === item.userCouponId}}" class="sheet-check">✓</text>
      </view>
    </view>
    <view class="sheet-item" data-id="" bindtap="onPickCoupon">
      <view class="sheet-item-main">
        <view class="sheet-item-name">不使用优惠券</view>
      </view>
      <view class="sheet-item-value">
        <text wx:if="{{!userCouponId}}" class="sheet-check">✓</text>
      </view>
    </view>
  </view>
</view>