/**checkout.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #222;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-sub {
  font-size: 28rpx;
  color: #ff5000;
  font-weight: 600;
}

.label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #222;
}

.count {
  font-size: 22rpx;
  color: #bbb;
}

.remark {
  width: 100%;
  height: 140rpx;
  font-size: 26rpx;
  color: #444;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.hint {
  font-size: 22rpx;
  color: #999;
  padding: 0 8rpx;
}

.offline {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding-top: 160rpx;
  font-size: 26rpx;
  color: #999;
}

.retry {
  padding: 16rpx 40rpx;
  background: #fff;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.dim {
  opacity: 0.6;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.total {
  font-size: 26rpx;
  color: #666;
}

.total-num {
  font-size: 38rpx;
  color: #ff5000;
  font-weight: 600;
}

.submit {
  background: #ff6b35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 48rpx;
}

.submit[disabled] {
  background: #ffb494 !important;
  color: #fff !important;
}

.submit-hover {
  opacity: 0.85;
}
