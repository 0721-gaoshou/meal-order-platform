/**checkout.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #222;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.item-sub {
  font-size: 28rpx;
  color: #ff5000;
  font-weight: 600;
}

.item-share {
  font-size: 22rpx;
  color: #e5533d;
}

.coupon-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.coupon-value {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.coupon-name {
  font-size: 26rpx;
  color: #ff5000;
}

.coupon-none {
  font-size: 26rpx;
  color: #bbb;
}

.arrow {
  font-size: 30rpx;
  color: #ccc;
}

.label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #222;
}

.count {
  font-size: 22rpx;
  color: #bbb;
}

.remark {
  width: 100%;
  height: 140rpx;
  font-size: 26rpx;
  color: #444;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.hint {
  font-size: 22rpx;
  color: #999;
  padding: 0 8rpx;
}

.offline {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding-top: 160rpx;
  font-size: 26rpx;
  color: #999;
}

.retry {
  padding: 16rpx 40rpx;
  background: #fff;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.dim {
  opacity: 0.6;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.totals {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.total-line {
  font-size: 22rpx;
  color: #999;
}

.total-line-off {
  color: #e5533d;
  margin-left: 12rpx;
}

.total {
  font-size: 26rpx;
  color: #666;
}

.total-num {
  font-size: 38rpx;
  color: #ff5000;
  font-weight: 600;
}

.submit {
  background: #ff6b35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 48rpx;
}

.submit[disabled] {
  background: #ffb494 !important;
  color: #fff !important;
}

.submit-hover {
  opacity: 0.85;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sheet-title {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
  text-align: center;
  padding-bottom: 12rpx;
}

.sheet-list {
  display: flex;
  flex-direction: column;
  max-height: 640rpx;
}

.sheet-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.sheet-item-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sheet-item-name {
  font-size: 28rpx;
  color: #222;
}

.sheet-item-desc {
  font-size: 22rpx;
  color: #999;
}

.sheet-item-value {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.sheet-item-off-amount {
  font-size: 26rpx;
  color: #e5533d;
}

.sheet-item-off .sheet-item-name,
.sheet-item-off .sheet-item-desc {
  color: #ccc;
}

.sheet-check {
  font-size: 28rpx;
  color: #ff6b35;
}